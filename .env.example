# ============================================================
# H11 Neubau – Umgebungsvariablen (Vorlage). Echte Werte NIE committen.
# ============================================================

# --- FRONTEND (offentlich, steht in config.js > H11_ORDERING.supabase) ---
# Supabase > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # "anon public" Key – darf im Browser stehen (RLS schutzt die Daten)

# --- SERVER-SECRETS (nur in Supabase Edge Function Secrets, NIE im Frontend!) ---
# Setzen mit:  supabase secrets set --env-file supabase/.env
STRIPE_SECRET_KEY=sk_test_...        # Stripe > Developers > API keys (Test-Modus!)
STRIPE_WEBHOOK_SECRET=whsec_...      # Stripe > Developers > Webhooks > Signing secret
SITE_URL=https://DEIN-NAME.github.io/DEIN-REPO   # Basis-URL der Website (ohne / am Ende)
# SITE_ORIGIN=https://DEIN-NAME.github.io        # optional: CORS auf deine Origin einschranken

# SUPABASE_SERVICE_ROLE_KEY und SUPABASE_URL stellt Supabase den Edge Functions automatisch bereit.
# Den service_role Key niemals ins Frontend, niemals in Git.
